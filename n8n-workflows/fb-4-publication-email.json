   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const item = $input.first();\nconst mail = item.json;\nconst bin = item.binary || {};\nconst att = Object.keys(bin)[0] || '';\nreturn [{ json: {\n  sujet: mail.subject || '',\n  texte: mail.text || mail.html || '',\n  piece_jointe: att,\n  mimeType: (att && bin[att] && bin[att].mimeType) || '',\n  nb_pieces: Object.keys(bin).length\n}, binary: bin }];"
   }
  },
