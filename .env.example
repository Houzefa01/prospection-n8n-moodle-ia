# ============================================================
# PROSPECTION FREELANCE — Moodle + IA (local, migrable VPS)
# Copier vers .env puis remplir :  cp .env.example .env
# JAMAIS de secrets en dur dans le code ou les workflows.
# ============================================================

# --- n8n local ---
# Authentification : n8n impose la création d'un compte propriétaire au premier
# lancement sur http://localhost:5678 (aucun accès anonyme, même en local).
# 32+ caractères aléatoires, ex: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-moi-32-caracteres-minimum-000000
N8N_PORT=5678
TZ=Indian/Antananarivo

# --- Identité (remplace [TON NOM] partout via variable) ---
FREELANCER_NAME=[TON NOM]
FREELANCER_ROLE=Développeur Moodle & Automatisation IA — basé à Madagascar
PROSPECTION_EMAIL=hsavatra@gmail.com

# --- SMTP Gmail (mot de passe d'APPLICATION, jamais le mot de passe principal) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hsavatra@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=

# --- IMAP (lecture réponses, même compte) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=hsavatra@gmail.com
IMAP_APP_PASSWORD=
# Dossier surveillé
IMAP_FOLDER=INBOX

# --- LLM (au moins UNE clé requise pour la personnalisation IA) ---
# Fournisseur par défaut : anthropic (modèle claude-haiku bon marché).
# Alternatives : openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.7

# --- Sourcing leads ---
APOLLO_API_KEY=
HUNTER_API_KEY=

# --- Telegram (notifications réponses) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Garde-fous métier (contraintes non négociables) ---
# true pendant les 3 premières semaines MINIMUM (aucun envoi sans validation)
REQUIRE_APPROVAL=true
# true = n'envoie rien réellement, logue seulement
DRY_RUN=true
# 10-15/jour max au démarrage
DAILY_SEND_LIMIT=12
WEEKLY_LEAD_TARGET=12

# --- Chemins (relatifs, migrables VPS — ne pas mettre de chemins absolus machine) ---
LEADS_DB_PATH=./data/leads.db
LEADS_CSV_PATH=./data/leads_import.csv

# --- Relances ---
FOLLOWUP_DAY_1=3
FOLLOWUP_DAY_2=7
FOLLOWUP_MAX=2
